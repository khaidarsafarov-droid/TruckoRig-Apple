<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>TruckoRig</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>ru</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>UIAppFonts</key>
	<array>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-SemiBold.ttf</string>
		<string>DMSans-Bold.ttf</string>
		<string>Roboto-Regular.ttf</string>
		<string>Roboto-Medium.ttf</string>
		<string>Roboto-Bold.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>NSCameraUsageDescription</key>
	<string>TruckoRig использует камеру, чтобы сфотографировать документы рейса и отсканировать бумаги.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TruckoRig может взять фото документа из галереи, если камера недоступна, и добавить страницы в сканер.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TruckoRig записывает место съёмки на фото рейса, чтобы было видно, где подписаны документы.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.truckorig</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>truckorig</string>
			</array>
		</dict>
		<!-- Reversed iOS OAuth client id. Replace together with GIDClientID. Keep the truckorig scheme. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.REPLACE_WITH_IOS_OAUTH_CLIENT_ID</string>
			</array>
		</dict>
	</array>

	<!-- Placeholder until an iOS OAuth client exists. Not a credential. Drive stays off while this value is unchanged. -->
	<key>GIDClientID</key>
	<string>REPLACE_WITH_IOS_OAUTH_CLIENT_ID.apps.googleusercontent.com</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.truckorig.drive-sync</string>
	</array>
</dict>
</plist>
