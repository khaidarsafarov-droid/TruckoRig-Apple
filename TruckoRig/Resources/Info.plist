<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>TruckoRig</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>ru</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>UIAppFonts</key>
	<array>
		<string>DMSans-Regular.ttf</string>
		<string>DMSans-Medium.ttf</string>
		<string>DMSans-SemiBold.ttf</string>
		<string>DMSans-Bold.ttf</string>
		<string>Roboto-Regular.ttf</string>
		<string>Roboto-Medium.ttf</string>
		<string>Roboto-Bold.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>NSCameraUsageDescription</key>
	<string>TruckoRig использует камеру, чтобы сфотографировать документы рейса и отсканировать бумаги.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TruckoRig может взять фото документа из галереи, если камера недоступна, и добавить страницы в сканер.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>TruckoRig записывает место съёмки на фото рейса, чтобы было видно, где подписаны документы.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.truckorig</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>truckorig</string>
			</array>
		</dict>
	</array>

	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.truckorig.telegram-sync</string>
		<string>com.truckorig.icloud-sync</string>
	</array>
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.truckorig</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>TruckoRig</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
	</array>

	<!-- Substituted from Config/Maps.xcconfig. Empty in CI; the map shows a fallback instead of crashing. -->
	<key>GMSApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
</dict>
</plist>
