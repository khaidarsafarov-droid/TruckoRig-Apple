    "settings.telegram.desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a token from @BotFather and tap Add bot. We set the bot name to TruckoRig and use the app photo. The token is stored securely and is not shown on this screen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите токен у @BotFather и нажмите «Добавить бота». Мы зададим боту имя TruckoRig и фото приложения. Токен хранится в защищённом хранилище и не отображается на экране."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un jeton auprès de @BotFather et touchez Ajouter le bot. Nous nommons le bot TruckoRig et utilisons la photo de l'app. Le jeton est stocké de façon sécurisée et n'est pas affiché sur cet écran."
          }
        }
      }
    },
