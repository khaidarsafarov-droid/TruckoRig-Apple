        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment obtenir un jeton"
          }
        }
      }
    },
    "onboard.telegram.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Tap Open BotFather — Telegram opens @BotFather."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Toca Abrir BotFather: Telegram abre @BotFather."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Нажмите «Открыть BotFather» — откроется бот @BotFather в Telegram."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Touchez Ouvrir BotFather — Telegram ouvre @BotFather."
          }
        }
      }
    },
    "onboard.telegram.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Send /newbot (new bot) or /token (if you already have one)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Envía /newbot (bot nuevo) o /token (si ya tienes uno)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Отправьте /newbot (новый бот) или /token (если бот уже есть)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Envoyez /newbot (nouveau bot) ou /token (si vous en avez déjà un)."
          }
        }
      }
    },
    "onboard.telegram.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Copy the token — it looks like 123456789:AAH…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Copia el token: se ve como 123456789:AAH…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Скопируйте токен — он выглядит как 123456789:AAH…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Copiez le jeton — il ressemble à 123456789:AAH…"
          }
        }
      }
    },
    "onboard.telegram.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Paste it below and tap Save. The bot is named TruckoRig, gets the app photo, and can receive loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Pégalo abajo y toca Guardar. El bot se llama TruckoRig, recibe la foto de la app y puede recibir cargas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Вставьте токен ниже и нажмите «Сохранить». Бот получит имя TruckoRig, фото приложения — и можно присылать грузы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Collez-le ci-dessous et touchez Enregistrer. Le bot est nommé TruckoRig, reçoit la photo de l'app et peut recevoir des voyages."
          }
        }
      }
    },
