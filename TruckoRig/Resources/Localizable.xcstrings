    "about.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Backup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Respaldo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Резервная копия"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Sauvegarde"
          }
        }
      }
    },
    "about.backup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings create a backup file on the phone and restore it when you change devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Ajustes crea un archivo de copia en el teléfono y restáuralo cuando cambies de dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Настройках создайте файл-бэкап на телефоне и восстановите его при смене устройства."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, créez un fichier de sauvegarde sur le téléphone et restaurez-le lorsque vous changez d'appareil."
          }
        }
      }
    },
    "about.diesel.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diesel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diésel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Дизель"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diesel"
          }
        }
      }
    },
    "about.diesel.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Diesel opens the fill journal. Pick all fills or this week. Each card shows date, location, amount, gallons, price, and discount. Photograph the receipt and gallons and price fill in on the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú → Diésel abre el diario de repostajes. Elige todos o esta semana. Cada tarjeta muestra fecha, lugar, importe, galones, precio y descuento. Fotografía el recibo y los galones y el precio se rellenan en el dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Дизель открывает журнал заправок. Можно смотреть все или эту неделю. На карточке дата, место, сумма, галлоны, цена и скидка. Сфотографируйте чек — галлоны и цена подставятся на устройстве."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Diesel ouvre le journal des pleins. Choisissez tous les pleins ou cette semaine. Chaque fiche montre la date, le lieu, le montant, les gallons, le prix et le rabais. Photographiez le reçu : les gallons et le prix se remplissent sur l'appareil."
          }
        }
      }
    },
    "about.dispute.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dispute"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Reclamo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Диспут"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Litige"
          }
        }
      }
    },
    "about.dispute.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the load check Dispute and pick a response date. When it is closed, mark it completed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el viaje marca Disputa y elige una fecha de respuesta. Cuando se cierre, márcala como completada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На рейсе отметьте диспут и дату ответа. Когда он закрыт, отметьте выполнение."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le voyage, cochez Litige et choisissez une date de réponse. Lorsqu'il est clos, marquez-le comme terminé."
          }
        }
      }
    },
    "about.docs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documents, camera, and scanner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documentos, cámara y escáner"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Документы, камера и сканер"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documents, caméra et numériseur"
          }
        }
      }
    },
    "about.docs.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents is the scan gallery. From a load you can take a photo or scan a document and attach it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentos es la galería de escaneos. Desde un viaje puedes hacer una foto o escanear un documento y adjuntarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы — галерея сканов. С карточки рейса можно снять фото или отсканировать документ и прикрепить его."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents est la galerie des numérisations. Depuis un voyage, vous pouvez prendre une photo ou numériser un document et le joindre."
          }
        }
      }
    },
    "about.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Weekly goal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Meta semanal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Недельная цель"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Objectif hebdomadaire"
          }
        }
      }
    },
    "about.goal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Goal tab set a weekly gross target. The app tracks progress, what is left, and the daily pace you need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la pestaña Meta fija un bruto semanal. La app sigue el progreso, lo que falta y el ritmo diario que necesitas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во вкладке Цель задайте недельный gross. Приложение считает прогресс, остаток и нужный темп в день."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet Objectif, fixez un brut hebdomadaire. L'app suit la progression, le reste et le rythme quotidien requis."
          }
        }
      }
    },
    "about.home.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Home journal"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Diario de inicio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Журнал"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Journal d'accueil"
          }
        }
      }
    },
    "about.home.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal lists trips by week. Search by Trip ID, city, or date. Open a card to edit, mark the finish, or attach photos and scans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario lista los viajes por semana. Busca por Trip ID, ciudad o fecha. Abre una tarjeta para editar, marcar el fin o adjuntar fotos y escaneos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал показывает рейсы по неделям. Ищите по Trip ID, городу или дате. Откройте карточку, чтобы править, отметить окончание или прикрепить фото и сканы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal liste les voyages par semaine. Cherchez par Trip ID, ville ou date. Ouvrez une fiche pour modifier, marquer la fin ou joindre des photos et des numérisations."
          }
        }
      }
    },
    "about.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use TruckoRig: loads, disputes, weekly goal, diesel, paychecks, taxes, map, reports, widget, and backups. Everything stays on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo usar TruckoRig: viajes, disputas, meta semanal, diésel, nóminas, impuestos, mapa, informes, widget y copias. Todo se queda en este teléfono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как пользоваться TruckoRig: рейсы, диспуты, недельная цель, дизель, зарплата, налоги, карта, отчёты, виджет и копии. Всё остаётся на этом телефоне."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment utiliser TruckoRig : voyages, litiges, objectif hebdomadaire, diesel, paies, impôts, carte, rapports, widget et sauvegardes. Tout reste sur ce téléphone."
          }
        }
      }
    },
    "about.loads.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Add a load"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Agregar una carga"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Добавить рейс"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ajouter un voyage"
          }
        }
      }
    },
    "about.loads.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add load and paste a message or fill in the form. You need a rate above zero and a pickup or delivery address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Añadir viaje y pega un mensaje o rellena el formulario. Necesitas una tarifa mayor que cero y una dirección de recogida o entrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите добавить рейс и вставьте сообщение или заполните форму. Нужна ставка больше нуля и адрес погрузки или выгрузки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Ajouter un voyage et collez un message ou remplissez le formulaire. Il faut un taux supérieur à zéro et une adresse de cueillette ou de livraison."
          }
        }
      }
    },
    "about.maintenance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Maintenance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Mantenimiento"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Обслуживание"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Entretien"
          }
        }
      }
    },
    "about.maintenance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Maintenance: reminders by miles or date, and completed services. Photograph a receipt and the app splits each job and the total."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú → Mantenimiento: recordatorios por millas o fecha, y servicios completados. Fotografía un recibo y la app separa cada trabajo y el total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Обслуживание: напоминания по милям или дате и выполненные работы. Сфотографируйте чек — приложение разнесёт работы и итог."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Entretien : rappels par milles ou par date, et entretiens terminés. Photographiez un reçu et l'app sépare chaque travail et le total."
          }
        }
      }
    },
    "about.map.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Map"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Mapa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Карта"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Carte"
          }
        }
      }
    },
    "about.map.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Map: your RPM by origin state for the week, month, or year. Tap a state for recent rates and top lanes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú → Mapa: tu RPM por estado de origen de la semana, mes o año. Toca un estado para ver tarifas recientes y las mejores lanes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → «Карта»: ваши RPM по штатам за неделю, месяц или год (откуда уехал груз). Нажмите штат — свежие ставки и топ-направления."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Carte : votre RPM par État d'origine pour la semaine, le mois ou l'année. Touchez un État pour les taux récents et les meilleurs couloirs."
          }
        }
      }
    },
    "about.paycheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Paycheck"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Pago"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Зарплата"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Paie"
          }
        }
      }
    },
    "about.paycheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Paycheck opens the payout journal. Add a photo or PDF text of the statement and check the net before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú → Nómina abre el diario de pagos. Añade una foto o el texto del PDF del estado de cuenta y revisa el neto antes de guardar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Зарплата открывает журнал выплат. Добавьте фото или текст ведомости и проверьте сумму на руки перед сохранением."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Paie ouvre le journal des versements. Ajoutez une photo ou le texte du relevé et vérifiez le net avant d'enregistrer."
          }
        }
      }
    },
