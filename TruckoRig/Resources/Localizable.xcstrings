    "premium.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first month is free. After that, the App Store charges the monthly price on the button — $2.99 in the United States."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer mes es gratis. Después, el App Store cobra el precio del botón: 2,99 $ al mes en Estados Unidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый месяц бесплатно. Дальше App Store списывает цену на кнопке — в США это 2,99 $ в месяц."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier mois est gratuit. Ensuite, l'App Store facture le prix mensuel indiqué sur le bouton — 2,99 $ aux États-Unis."
          }
        }
      }
    },
