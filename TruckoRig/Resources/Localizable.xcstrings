        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the TruckoRig home-screen widget: weekly gross and goal, plus camera, scanner, and Add diesel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет TruckoRig: недельный gross и цель, а также камера, сканер и дизель."
