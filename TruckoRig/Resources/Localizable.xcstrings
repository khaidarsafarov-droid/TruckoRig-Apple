    "onboard.telegram.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you create an account, connect a bot so Telegram messages can be parsed and saved as loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de crear una cuenta, conecta un bot para que los mensajes de Telegram se analicen y se guarden como cargas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После регистрации можно сразу привязать бота: он будет разбирать грузы из Telegram и сохранять их в приложение."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la création du compte, connectez un bot pour que les messages Telegram soient analysés et enregistrés comme voyages."
          }
        }
      }
    },
    "onboard.telegram.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to get a token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo obtener un token"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как получить токен"
