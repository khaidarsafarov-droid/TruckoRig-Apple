    "about.widget.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the TruckoRig home-screen widget: weekly gross and goal, plus camera, scanner, and Add diesel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el widget de TruckoRig en la pantalla de inicio: bruto y meta de la semana, más cámara, escáner y Añadir diésel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет TruckoRig: недельный gross и цель, а также камера, сканер и дизель."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le widget TruckoRig à l'écran d'accueil : brut et objectif de la semaine, plus la caméra, le numériseur et Ajouter le diesel."
          }
        }
      }
    },
