    "settings.icloud.media.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and scans are saved as files next to the JSON backup. Location and other photo details stay with the file. The Telegram token is not uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos y los escaneos se guardan como archivos junto a la copia JSON. La ubicación y los datos de la foto se quedan con el archivo. El token de Telegram no se sube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото и сканы сохраняются отдельными файлами рядом с JSON-копией. Геолокация и данные снимка остаются с файлом. Токен Telegram не выгружается."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos et les numérisations sont enregistrées comme fichiers à côté de la copie JSON. La position et les détails de la photo restent avec le fichier. Le jeton Telegram n'est pas envoyé."
          }
        }
      }
    },
    "settings.icloud.media.kept": {
      "extractionState": "manual",
      "localizations": {
