    "settings.backup.restoreBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current journal (loads, paychecks, diesel) will be replaced by the file. Photos and scans linked to removed loads will be deleted; other media on this device will be kept."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий журнал (грузы, зарплаты, дизель) будет заменён данными из файла. Фото и сканы, привязанные к удалённым грузам, будут удалены; остальные медиафайлы на устройстве сохранятся."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal actuel (voyages, paies, diesel) sera remplacé par le fichier. Les photos et les numérisations liées aux voyages retirés seront supprimées; les autres médias de cet appareil seront conservés."
          }
        }
      }
    },
    "settings.backup.restoreAction": {
      "extractionState": "manual",
      "localizations": {
