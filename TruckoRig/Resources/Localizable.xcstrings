    "goal.pace.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed per day spreads the gap over the days left. Actual per day divides gross by days actually in transit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Нужно в день» делит остаток на оставшиеся дни. «Факт в день» — валовая на дни в пути."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Requis par jour » répartit l'écart sur les jours restants. « Réel par jour » divise le brut par les jours réellement en route."
          }
        }
      }
    },
