    "about.settings.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings covers language, week start, RPM thresholds, privacy, and backup. Profile holds driver info."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes cubre el idioma, el inicio de semana, los umbrales de RPM, la privacidad y la copia. El perfil guarda los datos del conductor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках язык, начало недели, пороги RPM, приватность и копия. В профиле данные водителя."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages couvre la langue, le début de semaine, les seuils RPM, la confidentialité et la sauvegarde. Le profil contient les renseignements du chauffeur."
          }
        }
      }
    },
    "about.tax.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Taxes"
          }
        },
