    "premium.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first month is free. After that, the App Store charges the monthly price on the button — $2.99 in the United States. Telegram, analytics, the weekly goal, the map, taxes, scanner, camera, export, and Drive backup stay on this plan. Loads, diesel, paychecks, and deadhead stay free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer mes es gratis. Después, el App Store cobra el precio del botón: 2,99 $ al mes en Estados Unidos. Telegram, analítica, meta semanal, mapa, impuestos, escáner, cámara, exportación y copia en Drive quedan en este plan. Las cargas, el diésel, los pagos y el deadhead siguen gratis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый месяц бесплатно. Дальше App Store списывает цену на кнопке — в США это 2,99 $ в месяц. Telegram, аналитика, недельная цель, карта, налоги, сканер, камера, экспорт и копия в Drive остаются в этой подписке. Грузы, дизель, зарплаты и deadhead остаются бесплатными."
          }
        }
      }
    },
