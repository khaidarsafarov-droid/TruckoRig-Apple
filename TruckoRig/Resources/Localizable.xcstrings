        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No analytics, no advertising identifier, no crash reports. OCR runs on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin analítica, sin identificador de publicidad, sin informes de fallos. El OCR se ejecuta en el teléfono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
