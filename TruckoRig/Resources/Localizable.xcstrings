    "about.reports.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Reports: weekly and route income, with paycheck and diesel side by side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menú → Informes: ingresos por semana y ruta, con la nómina y el diésel uno al lado del otro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Отчёты: доход по неделям и маршрутам, зарплата и дизель рядом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Rapports : revenu par semaine et par trajet, avec la paie et le diesel côte à côte."
          }
        }
      }
    },
    "about.settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
