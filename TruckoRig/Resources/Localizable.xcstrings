    "about.telegram.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings add a bot token from @BotFather. The on-device bot reads messages and adds loads, paychecks, and diesel to the journal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Настройках добавьте токен бота от @BotFather. Бот на телефоне читает сообщения и сам добавляет в журнал грузы, зарплату и дизель."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, ajoutez un jeton de bot de @BotFather. Le bot sur l'appareil lit les messages et ajoute les voyages, les paies et le diesel au journal."
          }
        }
      }
    },
    "paycheck.telegram.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or forward the file to the Telegram bot — it also recognizes paychecks and asks before saving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или перешлите файл боту в Telegram — он тоже распознает зарплату и спросит подтверждение."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou transférez le fichier au bot Telegram — il reconnaît aussi les paies et demande une confirmation avant d'enregistrer."
          }
        }
      }
    },
