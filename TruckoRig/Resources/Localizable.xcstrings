    "about.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Резервная копия"
          }
        }
      }
    },
    "about.backup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings export a JSON file and import it on another phone. Google Drive is not in this version."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Настройках экспортируйте JSON и импортируйте его на другом телефоне. Google Drive в этой версии нет."
          }
        }
      }
    },
    "about.diesel.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diesel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Дизель"
          }
        }
      }
    },
    "about.diesel.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Diesel opens the fill journal. Pick all fills or this week. Each card shows date, location, amount, gallons, price, and discount. Photograph the receipt and gallons and price fill in on the device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Дизель открывает журнал заправок. Можно смотреть все или эту неделю. На карточке дата, место, сумма, галлоны, цена и скидка. Сфотографируйте чек — галлоны и цена подставятся на устройстве."
          }
        }
      }
    },
    "about.dispute.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dispute"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Диспут"
          }
        }
      }
    },
    "about.dispute.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the load check Dispute and pick a response date. When it is closed, mark it completed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На рейсе отметьте диспут и дату ответа. Когда он закрыт, отметьте выполнение."
          }
        }
      }
    },
    "about.docs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documents, camera, and scanner"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Документы, камера и сканер"
          }
        }
      }
    },
    "about.docs.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents is the scan gallery. From a load you can take a photo or scan a document and attach it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы — галерея сканов. С карточки рейса можно снять фото или отсканировать документ и прикрепить его."
          }
        }
      }
    },
    "about.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Weekly goal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Недельная цель"
          }
        }
      }
    },
    "about.goal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Goal tab set a weekly gross target. The app tracks progress, what is left, and the daily pace you need."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во вкладке Цель задайте недельный gross. Приложение считает прогресс, остаток и нужный темп в день."
          }
        }
      }
    },
    "about.home.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Home journal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Журнал"
          }
        }
      }
    },
    "about.home.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal lists trips by week. Search by Trip ID, city, or date. Open a card to edit, mark the finish, or attach photos and scans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал показывает рейсы по неделям. Ищите по Trip ID, городу или дате. Откройте карточку, чтобы править, отметить окончание или прикрепить фото и сканы."
          }
        }
      }
    },
    "about.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use TruckoRig: loads, disputes, weekly goal, diesel, paychecks, taxes, map, reports, widget, and backups. Everything stays on this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как пользоваться TruckoRig: рейсы, диспуты, недельная цель, дизель, зарплата, налоги, карта, отчёты, виджет и копии. Всё остаётся на этом телефоне."
          }
        }
      }
    },
    "about.loads.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Add a load"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Добавить рейс"
          }
        }
      }
    },
    "about.loads.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add load and paste a message or fill in the form. You need a rate above zero and a pickup or delivery address."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите добавить рейс и вставьте сообщение или заполните форму. Нужна ставка больше нуля и адрес погрузки или выгрузки."
          }
        }
      }
    },
    "about.maintenance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Maintenance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Обслуживание"
          }
        }
      }
    },
    "about.maintenance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Maintenance: reminders by miles or date, and completed services. Photograph a receipt and the app splits each job and the total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Обслуживание: напоминания по милям или дате и выполненные работы. Сфотографируйте чек — приложение разнесёт работы и итог."
          }
        }
      }
    },
    "about.map.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Map"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Карта"
          }
        }
      }
    },
    "about.map.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Map: your RPM by state. Tap a state for recent rates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Карта: ваш RPM по штатам. Нажмите штат, чтобы увидеть недавние ставки."
          }
        }
      }
    },
    "about.paycheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Paycheck"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Зарплата"
          }
        }
      }
    },
    "about.paycheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Paycheck opens the payout journal. Add a photo or PDF text of the statement and check the net before saving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Зарплата открывает журнал выплат. Добавьте фото или текст ведомости и проверьте сумму на руки перед сохранением."
          }
        }
      }
    },
    "about.reports.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Reports"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Отчёты"
          }
        }
      }
    },
    "about.reports.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Reports: weekly and route income, with paycheck and diesel side by side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Отчёты: доход по неделям и маршрутам, зарплата и дизель рядом."
          }
        }
      }
    },
    "about.settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15. Settings and profile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "15. Настройки и профиль"
          }
        }
      }
    },
    "about.settings.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings covers language, week start, RPM thresholds, privacy, and backup. Profile holds driver info."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках язык, начало недели, пороги RPM, приватность и копия. В профиле данные водителя."
          }
        }
      }
    },
    "about.tax.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Taxes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Налоги"
          }
        }
      }
    },
    "about.tax.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Taxes: a quarterly estimate from paycheck gross, diesel, and per diem ($69/day). It is a guide, not tax advice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Налоги: квартальная оценка из gross зарплаты, дизеля и per diem ($69 в день). Это ориентир, не налоговая консультация."
          }
        }
      }
    },
    "about.version": {
