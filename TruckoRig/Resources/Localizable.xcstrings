    "about.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Резервная копия"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "14. Sauvegarde"
          }
        }
      }
    },
    "about.backup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Settings create a backup file on the phone and restore it when you change devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Настройках создайте файл-бэкап на телефоне и восстановите его при смене устройства."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Réglages, créez un fichier de sauvegarde sur le téléphone et restaurez-le lorsque vous changez d'appareil."
          }
        }
      }
    },
    "about.diesel.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diesel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Дизель"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Diesel"
          }
        }
      }
    },
    "about.diesel.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Diesel opens the fill journal. Pick all fills or this week. Each card shows date, location, amount, gallons, price, and discount. Photograph the receipt and gallons and price fill in on the device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Дизель открывает журнал заправок. Можно смотреть все или эту неделю. На карточке дата, место, сумма, галлоны, цена и скидка. Сфотографируйте чек — галлоны и цена подставятся на устройстве."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Diesel ouvre le journal des pleins. Choisissez tous les pleins ou cette semaine. Chaque fiche montre la date, le lieu, le montant, les gallons, le prix et le rabais. Photographiez le reçu : les gallons et le prix se remplissent sur l'appareil."
          }
        }
      }
    },
    "about.dispute.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Dispute"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Диспут"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Litige"
          }
        }
      }
    },
    "about.dispute.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the load check Dispute and pick a response date. When it is closed, mark it completed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На рейсе отметьте диспут и дату ответа. Когда он закрыт, отметьте выполнение."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le voyage, cochez Litige et choisissez une date de réponse. Lorsqu'il est clos, marquez-le comme terminé."
          }
        }
      }
    },
    "about.docs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documents, camera, and scanner"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Документы, камера и сканер"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10. Documents, caméra et numériseur"
          }
        }
      }
    },
    "about.docs.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents is the scan gallery. From a load you can take a photo or scan a document and attach it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документы — галерея сканов. С карточки рейса можно снять фото или отсканировать документ и прикрепить его."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Documents est la galerie des numérisations. Depuis un voyage, vous pouvez prendre une photo ou numériser un document et le joindre."
          }
        }
      }
    },
    "about.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Weekly goal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Недельная цель"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Objectif hebdomadaire"
          }
        }
      }
    },
    "about.goal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Goal tab set a weekly gross target. The app tracks progress, what is left, and the daily pace you need."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во вкладке Цель задайте недельный gross. Приложение считает прогресс, остаток и нужный темп в день."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l'onglet Objectif, fixez un brut hebdomadaire. L'app suit la progression, le reste et le rythme quotidien requis."
          }
        }
      }
    },
    "about.home.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Home journal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Журнал"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Journal d'accueil"
          }
        }
      }
    },
    "about.home.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The journal lists trips by week. Search by Trip ID, city, or date. Open a card to edit, mark the finish, or attach photos and scans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал показывает рейсы по неделям. Ищите по Trip ID, городу или дате. Откройте карточку, чтобы править, отметить окончание или прикрепить фото и сканы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal liste les voyages par semaine. Cherchez par Trip ID, ville ou date. Ouvrez une fiche pour modifier, marquer la fin ou joindre des photos et des numérisations."
          }
        }
      }
    },
    "about.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to use TruckoRig: loads, disputes, weekly goal, diesel, paychecks, taxes, map, reports, widget, and backups. Everything stays on this phone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как пользоваться TruckoRig: рейсы, диспуты, недельная цель, дизель, зарплата, налоги, карта, отчёты, виджет и копии. Всё остаётся на этом телефоне."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment utiliser TruckoRig : voyages, litiges, objectif hebdomadaire, diesel, paies, impôts, carte, rapports, widget et sauvegardes. Tout reste sur ce téléphone."
          }
        }
      }
    },
    "about.loads.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Add a load"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Добавить рейс"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ajouter un voyage"
          }
        }
      }
    },
    "about.loads.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add load and paste a message or fill in the form. You need a rate above zero and a pickup or delivery address."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите добавить рейс и вставьте сообщение или заполните форму. Нужна ставка больше нуля и адрес погрузки или выгрузки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Ajouter un voyage et collez un message ou remplissez le formulaire. Il faut un taux supérieur à zéro et une adresse de cueillette ou de livraison."
          }
        }
      }
    },
    "about.maintenance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Maintenance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Обслуживание"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "11. Entretien"
          }
        }
      }
    },
    "about.maintenance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Maintenance: reminders by miles or date, and completed services. Photograph a receipt and the app splits each job and the total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Обслуживание: напоминания по милям или дате и выполненные работы. Сфотографируйте чек — приложение разнесёт работы и итог."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Entretien : rappels par milles ou par date, et entretiens terminés. Photographiez un reçu et l'app sépare chaque travail et le total."
          }
        }
      }
    },
    "about.map.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Map"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Карта"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "9. Carte"
          }
        }
      }
    },
    "about.map.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Map: your RPM by origin state for the week, month, or year. Tap a state for recent rates and top lanes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → «Карта»: ваши RPM по штатам за неделю, месяц или год (откуда уехал груз). Нажмите штат — свежие ставки и топ-направления."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Carte : votre RPM par État d'origine pour la semaine, le mois ou l'année. Touchez un État pour les taux récents et les meilleurs couloirs."
          }
        }
      }
    },
    "about.paycheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Paycheck"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Зарплата"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Paie"
          }
        }
      }
    },
    "about.paycheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Paycheck opens the payout journal. Add a photo or PDF text of the statement and check the net before saving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Зарплата открывает журнал выплат. Добавьте фото или текст ведомости и проверьте сумму на руки перед сохранением."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Paie ouvre le journal des versements. Ajoutez une photo ou le texte du relevé et vérifiez le net avant d'enregistrer."
          }
        }
      }
    },
    "about.reports.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Reports"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Отчёты"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "8. Rapports"
          }
        }
      }
    },
    "about.reports.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Reports: weekly and route income, with paycheck and diesel side by side."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Отчёты: доход по неделям и маршрутам, зарплата и дизель рядом."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Rapports : revenu par semaine et par trajet, avec la paie et le diesel côte à côte."
          }
        }
      }
    },
    "about.settings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15. Settings and profile"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "15. Настройки и профиль"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "15. Réglages et profil"
          }
        }
      }
    },
    "about.settings.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings covers language, week start, RPM thresholds, privacy, and backup. Profile holds driver info."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настройках язык, начало недели, пороги RPM, приватность и копия. В профиле данные водителя."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages couvre la langue, le début de semaine, les seuils RPM, la confidentialité et la sauvegarde. Le profil contient les renseignements du chauffeur."
          }
        }
      }
    },
    "about.tax.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Taxes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Налоги"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "7. Impôts"
          }
        }
      }
    },
    "about.tax.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Taxes: a quarterly estimate from paycheck gross, diesel, and per diem ($69/day). It is a guide, not tax advice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меню → Налоги: квартальная оценка из gross зарплаты, дизеля и per diem ($69 в день). Это ориентир, не налоговая консультация."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu → Impôts : une estimation trimestrielle à partir du brut de paie, du diesel et du per diem (69 $/jour). C'est un guide, pas un conseil fiscal."
          }
        }
      }
    },
    "about.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "about.widget.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12. Widget"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "12. Виджет"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "12. Widget"
          }
        }
      }
    },
    "about.widget.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the TruckoRig home-screen widget: weekly gross and goal, plus camera, scanner, and Add diesel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет TruckoRig: недельный gross и цель, а также камера, сканер и дизель."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le widget TruckoRig à l'écran d'accueil : brut et objectif de la semaine, plus la caméra, le numériseur et Ajouter le diesel."
          }
        }
      }
    },
    "diesel.discount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discount price"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена со скидкой"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prix avec rabais"
          }
        }
      }
    },
    "diesel.error.amount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an amount greater than zero"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите сумму больше нуля"
          }
        },
        "fr": {
          "stringUnit": {
