{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig uses the camera to photograph trip documents and scan paperwork."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig usa la cámara para fotografiar los documentos del viaje y escanear los papeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig utilise la caméra pour photographier les documents du voyage et numériser les papiers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig использует камеру, чтобы сфотографировать документы рейса и отсканировать бумаги."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig records where a trip photo was taken so you can see where the documents were signed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig registra el lugar de la foto del viaje para que veas dónde se firmaron los documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig enregistre le lieu de la prise de vue sur la photo du voyage, afin d'indiquer où les documents ont été signés."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig записывает место съёмки на фото рейса, чтобы было видно, где подписаны документы."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig can choose a document photo from your library when the camera is unavailable, and add pages to the scanner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig puede elegir una foto del documento en tu fototeca si la cámara no está disponible, y añadir páginas al escáner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig peut prendre une photo du document dans la photothèque si la caméra n'est pas disponible, et ajouter des pages au numériseur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TruckoRig может взять фото документа из галереи, если камера недоступна, и добавить страницы в сканер."
          }
        }
      }
    }
  },
  "version": "1.0"
}
